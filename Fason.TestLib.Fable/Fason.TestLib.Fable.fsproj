<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <!-- Type-checks the Fable branches of the shared sources when built by dotnet. -->
        <DefineConstants>FABLE_COMPILER</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../Fason/Library.fs"/>
        <Compile Include="../Fason.TestLib/Types.fs"/>
        <Compile Include="../Fason.TestLib/Fason.Generated.fs"/>
        <Compile Include="../Fason.TestLib/Program.fs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.UMX" Version="1.1.0"/>
        <PackageReference Include="Fable.Core" Version="5.0.0"/>
        <PackageReference Include="Thoth.Json" Version="10.5.1"/>
    </ItemGroup>

</Project>
